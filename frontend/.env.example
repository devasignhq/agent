# Frontend (Vite) build-time env. Vite only exposes vars prefixed with VITE_,
# and INLINES them at build time — so in prod these must be set in the Vercel
# build environment, not just at runtime. Copy to .env for local dev.

# Backend API origin — an absolute origin, NO trailing slash and no path,
# e.g. https://devasign-agent.onrender.com
#
# REQUIRED for a production build: there is no fallback host, and `vite build`
# fails fast when this is unset, empty, or not an origin (see vite.config.ts).
# For local dev, leave it UNSET to call http://localhost:8787 directly, or set
# it EMPTY to use relative URLs and go through the Vite dev proxy.
VITE_API_BASE=
