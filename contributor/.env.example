# Contributor app (Vite) build-time env. Vite only exposes vars prefixed with
# VITE_, and INLINES them at build time — so in prod these must be set in the
# Vercel build environment, not just at runtime. Copy to .env for local dev.

# Backend API origin. Defaults to http://localhost:8787 in dev and
# https://api.devasign.ai in a prod build when unset (see src/api.ts).
VITE_API_BASE=

