#!/usr/bin/env bash
# DevAsign post-commit hook — reviews every local commit in the background.
# Non-blocking by design: post-commit cannot stop a commit. The blocking gate is pre-push.
# Opt out of one commit with: DEVASIGN_SKIP=1 git commit ...
#
# SECURITY: this runs an agent, unattended, over commit content that may not be
# yours — a merged PR, a fetched contributor branch. Instruction-shaped text in
# that content can try to steer it, so this path does not get blanket Bash: it
# gets git only. That shrinks the blast radius, it is not a sandbox — git aliases
# and -c config can still execute, and Write can still touch files. Set
# DEVASIGN_ALLOWED_TOOLS to widen it (full Bash) or tighten it further.
set -u
TOOLS="${DEVASIGN_ALLOWED_TOOLS:-Agent,Read,Grep,Glob,Bash(git *),Write}"
STALE_MINUTES="${DEVASIGN_LOCK_STALE_MINUTES:-120}"
command -v claude >/dev/null 2>&1 || exit 0
[ "${DEVASIGN_SKIP:-0}" = "1" ] && exit 0
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
SHA=$(git rev-parse HEAD)
SHORT=$(git rev-parse --short HEAD)
# Cheap skips here; review-lead re-checks the full .devasign.yml commit.* rules.
git rev-parse -q --verify HEAD^2 >/dev/null 2>&1 && exit 0   # merge commit
case "$(git log -1 --pretty=%s)" in
  fixup!*|squash!*|wip*|WIP*) exit 0 ;;
esac
RUN="$ROOT/.devasign"; OUT="$RUN/reviews"
QDIR="$RUN/queue"; LOCK="$RUN/.review.lock"; LOCKPID="$LOCK.pid"
mkdir -p "$QDIR" "$OUT"
touch "$QDIR/$(date +%s)-$SHA"
# A lock whose runner was killed (SIGKILL, reboot) would otherwise stop reviews forever.
lock_is_stale() {
  lockpid=$(cat "$LOCKPID" 2>/dev/null) || lockpid=""
  if [ -n "$lockpid" ]; then
    kill -0 "$lockpid" 2>/dev/null && return 1   # a live runner holds it
    return 0
  fi
  # No pid recorded yet: a runner that just started is not stale, an old lock is.
  [ -n "$(find "$LOCK" -maxdepth 0 -mmin +"$STALE_MINUTES" 2>/dev/null)" ]
}
# One runner at a time; extra commits queue up and are processed in order.
claimed=no
if mkdir "$LOCK" 2>/dev/null; then
  # Drop any pid left by an earlier runner before ours is recorded, so a commit
  # arriving in that gap cannot read a dead pid and reclaim our live lock.
  rm -f "$LOCKPID" 2>/dev/null
  claimed=yes
elif lock_is_stale; then
  rmdir "$LOCK" 2>/dev/null; rm -f "$LOCKPID" 2>/dev/null
  mkdir "$LOCK" 2>/dev/null && { claimed=yes; echo "devasign: reclaimed a stale review lock"; }
fi
if [ "$claimed" = yes ]; then
  (
    trap 'rmdir "$LOCK" 2>/dev/null; rm -f "$LOCKPID" 2>/dev/null' EXIT
    cd "$ROOT" || exit 0
    while :; do
      qfile=$(ls -1 "$QDIR" 2>/dev/null | head -n 1)
      if [ -z "${qfile:-}" ]; then
        # Release, then look again: a commit queued while we still held the lock
        # would otherwise sit there until some later commit started a new runner.
        rmdir "$LOCK" 2>/dev/null
        qfile=$(ls -1 "$QDIR" 2>/dev/null | head -n 1)
        if [ -z "${qfile:-}" ] || ! mkdir "$LOCK" 2>/dev/null; then
          trap - EXIT   # the lock is gone or another runner's now; never remove theirs
          break
        fi
      fi
      s="${qfile#*-}"
      rm -f "$QDIR/$qfile"
      short=$(git rev-parse --short "$s" 2>/dev/null || echo "$s")
      # Prompt must precede --allowedTools: it is variadic and would eat the prompt.
      claude -p "Review commit $s" \
        --agent review-lead \
        --allowedTools "$TOOLS" \
        < /dev/null > "$OUT/$short.log" 2>&1
    done
  ) >/dev/null 2>&1 &
  # The runner's own pid, recorded by us: bash 3.2 has no BASHPID for it to use.
  echo $! > "$LOCKPID" 2>/dev/null
  echo "devasign: reviewing $SHORT in the background -> .devasign/reviews/$SHORT.log"
else
  echo "devasign: $SHORT queued for review"
fi
exit 0
