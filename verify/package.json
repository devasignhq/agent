{
  "name": "@devasign/verify",
  "version": "1.3.3",
  "description": "Runs DevAsign's generated acceptance tests inside your CI and reports per-criterion evidence.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bin": {
    "devasign-verify": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx/esm --test 'src/**/*.test.ts'",
    "test:e2e": "node --import tsx/esm --test test/e2e.test.ts",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@playwright/test": "1.55.0",
    "tsx": "^4.22.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devasignhq/agent.git",
    "directory": "verify"
  },
  "homepage": "https://github.com/devasignhq/verify-action",
  "keywords": [
    "devasign",
    "ci",
    "testing",
    "playwright",
    "verification"
  ]
}
