{
  "name": "devasign-backend",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps --import tsx/esm src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx scripts/seed.ts",
    "dev:ephemeral": "tsx scripts/ephemeral-dev.ts",
    "test": "DATABASE_URL= ANTHROPIC_API_KEY= GEMINI_API_KEY= STATSIG_SECRET_KEY= node --import tsx/esm --test 'src/**/*.test.ts'",
    "eval:criteria": "tsx scripts/eval-criteria.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@statsig/statsig-node-core": "^0.19.5",
    "@stellar/stellar-sdk": "^13.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.21.0",
    "stripe": "^22.2.0",
    "tsx": "^4.22.4",
    "uuid": "^11.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.20.0",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "toml": "^4.2.0"
  }
}
