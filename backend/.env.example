# --- Server ---
PORT=8787
# Dashboard origin: the CORS allow-origin AND the base for the post-OAuth
# redirect. In prod set the https dashboard URL with NO trailing slash
# (e.g. https://www.devasign.ai). https here also flips the session cookie to
# SameSite=None; Secure so it survives the www -> api cross-origin XHR.
WEB_ORIGIN=http://localhost:5173
# Contributor (developer) app origin: joins WEB_ORIGIN in the CORS/CSRF
# allowlist and is where the OAuth callback returns `?app=contributor` sign-ins
# and where the bot comment's "Apply for this bounty" CTA points. Must be a
# devasign.ai subdomain in prod (session cookie is same-site scoped), e.g.
# https://contributors.devasign.ai. Defaults to the local dev server.
CONTRIBUTOR_ORIGIN=http://localhost:3002
# Signs session cookies AND the bounty fund/cancel/approve links (both HS256
# JWTs), so anyone who knows it can impersonate any user. The value below is a
# public placeholder: the server refuses to boot with it (or with any secret
# under 16 chars) once WEB_ORIGIN is https or NODE_ENV=production. Unset, it
# falls back to a dev-only default that is rejected in prod the same way.
# In prod set this in the Render dashboard — do NOT commit it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating: put the OLD value in SESSION_SECRET_PREVIOUS (comma-separated) so
# live sessions survive, then drop it after 7 days. Placeholders are rejected
# there too — never park this literal in it.
SESSION_SECRET=replace-me-with-a-long-random-string

# --- GitHub OAuth (for user identity) ---
# Create at https://github.com/settings/applications/new
# Authorization callback URL: http://localhost:8787/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- GitHub App (for repo access) ---
# Create at https://github.com/settings/apps/new
# Webhook URL: http://your-tunnel/api/webhooks/github
GITHUB_APP_ID=
GITHUB_APP_NAME=devasign
GITHUB_APP_WEBHOOK_SECRET=
# Paste the App private key content (BEGIN/END RSA PRIVATE KEY) or set GITHUB_APP_PRIVATE_KEY_PATH.
# In prod (Render) use GITHUB_APP_PRIVATE_KEY with the inline contents — there is
# no file for _PATH to point at. Single-line values with literal \n are accepted.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=

# --- LLM ---
# Real reviews when set, deterministic mock otherwise (so dev works without a key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# --- Video understanding (Gemini 2.5 Pro) ---
# Used to transcribe / understand Loom / YouTube / Vimeo attachments so Opus
# can reason about them. Falls back to a deterministic mock when unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- Linear OAuth (connect a Linear workspace) ---
# Create a PUBLIC OAuth application at https://linear.app/settings/api/applications/new
# Callback URL: http://localhost:8787/api/auth/linear/callback
#   (prod: https://api.devasign.ai/api/auth/linear/callback)
# Request read + write scope. On connect, DevAsign synthesizes acceptance criteria
# from opened tickets and posts a short notification comment when a linked PR is
# reviewed (full verdict lands on the PR).
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
# Public OAuth apps use ONE app-level webhook configured in the Linear app
# settings: enable "Webhooks", set the URL to <api-host>/api/webhooks/linear,
# check the Issues + Comments (and Issue attachments + Project updates) event
# types, and copy the app's "Webhook signing secret" (lin_wh_…) here. DevAsign
# verifies every inbound Linear webhook against this one secret.
LINEAR_WEBHOOK_SIGNING_SECRET=

# --- Integrations (all optional; stubs are fine for dev) ---
# Per-user integrations are configured via POST /api/integrations. The vars
# below are workspace-wide fallbacks: when no per-user Slack/Discord row
# exists, broadcastVerdict() posts to the env-configured channel instead.
SLACK_BOT_TOKEN=
SLACK_BOT_CHANNEL=
LINEAR_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_BOT_CHANNEL_ID=

# --- Billing (Stripe) ---
# Subscriptions for Pro ($15/mo) and Max ($45/mo), both with a 14-day trial.
# When these are unset the billing routes return 503 and the app still boots —
# Free is the only reachable tier. Keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Create two recurring monthly Products/Prices in Stripe and paste their
# price_… IDs here (Pro = $15/mo, Max = $45/mo).
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
# Annual billing (optional, additive). Create two recurring *yearly* Prices at
# the FULL rate (Pro = $180/yr, Max = $540/yr) — the 20% off comes from the
# coupon below, not the price — and one Coupon (percent_off: 20, duration:
# forever). When any of these three is unset the annual option is hidden and
# only monthly is offered. Effective annual prices shown to users: $144 / $432.
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_MAX_ANNUAL=
STRIPE_COUPON_ANNUAL=
# Webhook signing secret (whsec_…). For local dev, run:
#   stripe listen --forward-to localhost:8787/api/webhooks/stripe
# and copy the printed secret here. In prod, use the secret shown for the
# endpoint you register at https://api.devasign.ai/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# --- Transactional email (Resend) ---
# Powers the account-deletion lifecycle emails (scheduled / day-12 reminder /
# final "your account was wiped"). Create an API key at https://resend.com and
# verify your sending domain (devasign.ai) so mail isn't rejected. When unset,
# the email helpers just log a preview and the app still works — handy for dev.
RESEND_API_KEY=
# From address for those emails. Must be on a Resend-verified domain in prod.
EMAIL_FROM=DevAsign <no-reply@devasign.ai>

# --- Analytics (Statsig) ---
# Server secret key (console.statsig.com → Settings → Keys & Environments).
# When unset, event tracking no-ops and the app still boots — fine for dev.
STATSIG_SECRET_KEY=
# Environment tier stamped on logged events: development (default) | staging |
# production. Set to production on Render.
STATSIG_ENVIRONMENT=

# --- Persistence (Neon Postgres) ---
# Source of truth for all persisted state. Grab a connection string from the
# Neon dashboard (https://neon.tech). Leave empty to run with an ephemeral,
# process-local in-memory store (no persistence) — handy for throwaway tests.
#
# IMPORTANT: dev and prod must NOT share one database. The app holds the whole
# dataset in memory and writes through to Postgres, so two processes pointed at
# the same DB clobber each other, and a local run can mutate/delete prod rows.
# For local dev, create a Neon BRANCH off prod (Neon console → Branches → "New
# branch") and use that branch's connection string here; prod (Render) stays on
# the primary branch. The boot log prints `[db] connected to Postgres [host/db]`
# so you can confirm each environment is on its own database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# --- At-rest secret encryption ---
# Encrypts integration tokens (Linear/Slack/Discord) before they're written to
# Postgres, so a DB compromise or a leaked Neon snapshot can't read them. 64 hex
# chars = a 32-byte AES-256-GCM key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When unset, tokens are stored in PLAINTEXT (the app still boots and warns at
# startup; /api/health reports encryption "unconfigured"). In prod set this in
# the Render dashboard alongside SESSION_SECRET — do NOT commit it. Rotating the
# key requires re-encrypting existing rows, so treat it like SESSION_SECRET.
INTEGRATION_ENCRYPTION_KEY=

# --- Stellar / Soroban escrow (bounties) ---
# Powers the USDC-escrow bounty feature. NON-CUSTODIAL: sponsors sign create_escrow
# and release with their OWN Freighter wallet (client-side); the backend holds only
# the ADMIN seed below, used to auto-release on PR merge (admin_release) and to
# refund on deadline/delete (admin_refund) as the escrow's trusted arbiter.
# When contractId / usdcSac / adminSecret are unset the bounty routes return 503,
# the escrow keeper no-ops, and the rest of the app boots normally.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# The deployed escrow contract id (C…) and the USDC Stellar Asset Contract id (C…)
# it was initialized with. Created at deploy time — no public defaults.
STELLAR_ESCROW_CONTRACT_ID=
STELLAR_USDC_SAC_ID=
# The platform admin Stellar secret seed (S…). This is the ONLY signing key the
# server holds. Paste it inline, or point STELLAR_ADMIN_SECRET_PATH at a file.
# Fund this account with XLM (fees) + a USDC trustline before use. Treat it like
# SESSION_SECRET — never commit it; use a KMS/HSM before handling real value.
STELLAR_ADMIN_SECRET=
STELLAR_ADMIN_SECRET_PATH=
# Testnet faucet, used only by dev tooling to bootstrap accounts (never on the
# request path).
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
